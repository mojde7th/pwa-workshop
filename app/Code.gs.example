/**
 * NEW Apps Script. Not DailyLog.
 * Sheet empty → Extensions → Apps Script → paste.
 * Deploy → New deployment → Web app → Me → Anyone.
 * After edits: editor Save, then Manage deployments → pencil → New version.
 * Same /exec URL. Do not make Untitled project.
 */
const SCRIPT_VERSION = "lab-v1";
const SHEET_ID = "PASTE_NEW_SPREADSHEET_ID";
const SECRET = "new-secret-not-dailylog";

function doGet() {
  return ContentService.createTextOutput(
    JSON.stringify({ ok: true, version: SCRIPT_VERSION })
  ).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  const body = JSON.parse(e.postData.contents);
  if (body.secret !== SECRET) {
    return json_({ ok: false, error: "bad secret" });
  }
  if (body.version && body.version !== SCRIPT_VERSION) {
    return json_({ ok: false, error: "app/script mismatch", version: SCRIPT_VERSION });
  }
  const ss = SpreadsheetApp.openById(SHEET_ID);
  let sh = ss.getSheetByName("LAB");
  if (!sh) sh = ss.insertSheet("LAB");
  if (sh.getLastRow() === 0) sh.appendRow(["ts", "payload"]);
  sh.appendRow([new Date(), JSON.stringify(body.rows || body)]);
  return json_({ ok: true, version: SCRIPT_VERSION });
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(
    ContentService.MimeType.JSON
  );
}
